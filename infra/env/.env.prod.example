# ============================================
# Cargo Pilot - Production Environment
# ============================================
# US-D05a-infra: Altyapı ortam yapılandırması
#
# ⚠️  UYARI: Production ortamı için örnek dosyadır.
# Gerçek production değerleri bu dosyaya YAZILMAZ.
# Production secret'ları güvenli secret management ile yönetilmelidir.
#
# Kullanım:
#   1. Bu dosyayı kopyala: cp .env.prod.example .env.prod
#   2. Placeholder değerleri güçlü parolalar ve güvenli değerlerle değiştir
#   3. Docker Compose ile kullan:
#      docker compose -f infra/compose/docker-compose.prod.yml --env-file infra/env/.env.prod up -d
#
# ⚠️  .env.prod dosyası repoya EKLENMEZ (.gitignore'da tanımlı)
# ============================================

# ─── Genel ───────────────────────────────────
ENVIRONMENT=production

# ─── MSSQL ───────────────────────────────────
# SQL Server için gerekli yapılandırma
# Production için GÜÇLÜ parola kullanılmalıdır
MSSQL_PORT=1433
MSSQL_DATABASE=CargoPilot
MSSQL_SA_PASSWORD=<GENERATE_STRONG_PASSWORD_MIN_16_CHARS>

# ─── MinIO ───────────────────────────────────
# Object storage için gerekli yapılandırma
# Production için GÜÇLÜ credentials kullanılmalıdır
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=<GENERATE_SECURE_USERNAME>
MINIO_ROOT_PASSWORD=<GENERATE_STRONG_PASSWORD_MIN_16_CHARS>
MINIO_BUCKET=cargo-pilot

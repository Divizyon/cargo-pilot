# ============================================
# Cargo Pilot - Test Environment
# ============================================
# US-D05a-infra: Altyapı ortam yapılandırması
#
# Kullanım:
#   1. Bu dosyayı kopyala: cp .env.test.example .env.test
#   2. Placeholder değerleri gerçek değerlerle değiştir
#   3. Docker Compose ile kullan:
#      docker compose -f infra/compose/docker-compose.test.yml --env-file infra/env/.env.test up -d
#
# ⚠️  .env.test dosyası repoya EKLENMEZ (.gitignore'da tanımlı)
# ============================================

# ─── Genel ───────────────────────────────────
ENVIRONMENT=test
BACKEND_PORT=8081
FRONTEND_PORT=3001

# ─── MSSQL ───────────────────────────────────
# SQL Server için gerekli yapılandırma
# Test ortamında farklı port kullanılabilir (çakışma önleme)
MSSQL_PORT=1434
MSSQL_DATABASE=CargoPilotTest
MSSQL_SA_PASSWORD=<CHANGE_ME_TEST_PASSWORD>

# ─── MinIO ───────────────────────────────────
# Object storage için gerekli yapılandırma
# Test ortamında farklı port kullanılabilir (çakışma önleme)
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_ROOT_USER=<CHANGE_ME_TEST_USER>
MINIO_ROOT_PASSWORD=<CHANGE_ME_TEST_PASSWORD>
MINIO_BUCKET=cargo-pilot-test

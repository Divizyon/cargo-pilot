# ============================================
# Cargo Pilot - Test Environment
# ============================================
# US-D05a-infra: Altyapı ortam yapılandırması
#
# Kullanım:
#   1. Bu dosyayı kopyala: cp .env.test.example .env.test
#   2. Placeholder değerleri gerçek değerlerle değiştir
#   3. Docker Compose ile kullan:
#      docker compose -f infra/compose/docker-compose.test.yml --env-file infra/env/.env.test up -d
#
# ⚠️  .env.test dosyası repoya EKLENMEZ (.gitignore'da tanımlı)
# ============================================

# ─── Genel ───────────────────────────────────
ENVIRONMENT=test
BACKEND_PORT=8081
FRONTEND_PORT=3001

# ─── GHCR Image ──────────────────────────────
# Docker Compose'un kullanacağı image kaynağı ve etiketi.
# CI tarafından otomatik doldurulur; local geliştirmede boş bırak (varsayılan: test).
# Rollback: IMAGE_TAG=test-<7-char-sha> şeklinde belirli bir sürüme dönülebilir.
GHCR_OWNER=divizyon
IMAGE_TAG=test

# ─── Frontend API URL (build-time) ───────────
# Nginx + domain kurulumunda gerçek domain yaz:
#   VITE_API_BASE_URL=https://cargopilot.divizyon.org
# Local geliştirmede boş bırak (compose otomatik localhost kullanır)
VITE_API_BASE_URL=

# ─── MSSQL ───────────────────────────────────
# SQL Server için gerekli yapılandırma
# Test ortamında farklı port kullanılabilir (çakışma önleme)
MSSQL_PORT=1434
MSSQL_DATABASE=CargoPilotTest
MSSQL_SA_PASSWORD=<CHANGE_ME_TEST_PASSWORD>

# ─── MinIO ───────────────────────────────────
# Object storage için gerekli yapılandırma
# Test ortamında farklı port kullanılabilir (çakışma önleme)
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_ROOT_USER=<CHANGE_ME_TEST_USER>
MINIO_ROOT_PASSWORD=<CHANGE_ME_TEST_PASSWORD>
MINIO_BUCKET=cargo-pilot-test

# ─── JWT ─────────────────────────────────────
# En az 32 karakter olmalı
JWT_SECRET=<CHANGE_ME_JWT_SECRET_MIN_32_CHARS>

# ─── Seed ────────────────────────────────────
# İlk admin hesabı için parola (uygulama ilk başladığında oluşturulur)
Seed__DefaultAdminPassword=<CHANGE_ME_ADMIN_PASSWORD>

# ─── Sunucu / Dağıtım ────────────────────────
# Sunucu IP veya domain (nginx + domain kurulumunda doldur; local'de boş bırak)
SERVER_HOST=
# Uygulama sürümü (deployment sırasında CI tarafından doldurulur; local'de boş bırak)
APP_VERSION=dev

# ─── OAuth (opsiyonel) ───────────────────────
# Tanımlanmazsa login ekranındaki OAuth butonları pasif kalır
VITE_OAUTH_GOOGLE_URL=
VITE_OAUTH_MICROSOFT_URL=

# ─── Google OAuth ─────────────────────────────
# Google Cloud Console → API & Services → Credentials → OAuth 2.0 Client ID
# Tanımlanmazsa Google ile giriş devre dışı kalır
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Vite Dev Proxy (local frontend geliştirme) ──
# npm run dev ile çalışırken /api istekleri bu adrese proxy edilir
# Docker Compose kullanılıyorsa bu değişkene gerek yoktur
VITE_DEV_PROXY_TARGET=http://localhost:8081

# ─── Resend (e-posta) ─────────────────────────
# resend.com → API Keys
# Tanımlanmazsa e-posta gönderimi (şifre sıfırlama vb.) çalışmaz
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
PASSWORD_RESET_FRONTEND_URL=https://cargopilot.divizyon.org/auth/reset-password

# ============================================
# Cargo Pilot - Development Environment
# ============================================
# US-D05a-infra: Altyapı ortam yapılandırması
#
# Kullanım:
#   1. Bu dosyayı kopyala: cp .env.dev.example .env.dev
#   2. Gerekirse değerleri düzenle (hazır default'lar local için çalışır)
#   3. Docker Compose ile kullan:
#      docker compose -f infra/compose/docker-compose.dev.yml --env-file infra/env/.env.dev up -d
#
# ⚠️  .env.dev dosyası repoya EKLENMEZ (.gitignore'da tanımlı)
# ============================================

# ─── Genel ───────────────────────────────────
ENVIRONMENT=development
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ─── MSSQL ───────────────────────────────────
# SQL Server için gerekli yapılandırma
MSSQL_PORT=1433
MSSQL_DATABASE=CargoPilotDev
MSSQL_SA_PASSWORD=DevPassword123!

# Backend'in runtime'da okuduğu tek bağlantı dizesi.
# Host = mssql (Docker network içindeki servis adı). Host makinesinden
# dotnet ef için kullanılırken 'mssql' yerine 'localhost' yazılmalıdır.
DATABASE_CONNECTION_STRING=Server=mssql,1433;Database=CargoPilotDev;User Id=sa;Password=DevPassword123!;TrustServerCertificate=True;

# ─── MinIO ───────────────────────────────────
# Object storage için gerekli yapılandırma
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=cargo-pilot-dev

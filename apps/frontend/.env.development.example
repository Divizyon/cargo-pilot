# ============================================================
# Cargo Pilot Frontend — Local Development Environment
# ============================================================
# Kullanım:
#   cp apps/frontend/.env.development.example apps/frontend/.env.development
#   Değerleri kendi local kurulumunuza göre düzenleyin.
#
# ⚠️  .env.development dosyası repoya EKLENMEZi (.gitignore'da tanımlı)
# ============================================================

# Backend API URL — local backend için:
VITE_API_BASE_URL=

# Uygulama meta
VITE_APP_VERSION=0.0.1
VITE_APP_ENV=development

# OAuth Client ID'leri — Google Cloud Console ve Azure Portal'dan alınır; boş bırakılırsa butonlar pasif kalır
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=

    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.22",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "i18next": "^26.5.6",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.3",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",

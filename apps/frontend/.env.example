# ============================================================
# Cargo Pilot Frontend — Environment Variables
# ============================================================
# Bu dosya tüm gerekli ortam değişkenlerini belgeler.
# Gerçek değerleri içermeyen bir şablon dosyasıdır.
# Kullanım: İlgili ortam dosyasını (.env.development vb.) kopyalayıp doldurun.
# ============================================================

# Backend API base URL
# Örnek: http://localhost:5000/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Uygulama sürümü (package.json ile senkronize tutulmalı)
VITE_APP_VERSION=0.0.1

# Ortam tanımlayıcısı: development | test | production
VITE_APP_ENV=development

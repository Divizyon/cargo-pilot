{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ApplicationSettings": {
    "AppName": "CargoPilot LogiTech",
    "Version": "1.0.0"
  },
  "Jwt": {
    "Issuer": "cargopilot-api",
    "Audience": "cargopilot-client",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryMinutes": 10080
  },
  "OAuth": {
    "Google": {
      "ClientId": ""
    },
    "Microsoft": {
      "ClientId": "",
      "TenantId": "common"
    }
  }
}

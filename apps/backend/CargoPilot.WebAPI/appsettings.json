{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ApplicationSettings": {
    "AppName": "CargoPilot LogiTech",
    "Version": "1.0.0"
  },
  "Jwt": {
    "Issuer": "cargopilot-api",
    "Audience": "cargopilot-client",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryMinutes": 10080
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "FromAddress": "noreply@cargopilot.com",
    "FromName": "Cargo Pilot"
  },
  "PasswordReset": {
    "FrontendResetUrl": "http://localhost:3001/auth/reset-password",
    "TokenExpiryMinutes": 10
  }
}

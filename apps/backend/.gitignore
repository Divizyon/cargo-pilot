# ------------------------------------------------------------
# CargoPilot .gitignore
# ------------------------------------------------------------

# Build outputs
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/

# Visual Studio / Rider user-specific files
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Test & logs
TestResults/
*.log

# Secret & environment files
# appsettings.Development.json → repoda placeholder değerler içerir, gerçek şifreyi
# appsettings.Development.Local.json dosyasına koy (aşağıdaki pattern ile gitignored).
appsettings.*.Local.json
.env
.env.local
.env.*.local
secrets.json
*.pfx
*.key

# NuGet
*.nupkg
packages/

# Publish output
publish/
*.publishsettings

# OS-generated
Thumbs.db
.DS_Store
*.lscache
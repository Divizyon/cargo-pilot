# ============================================
# Cargo Pilot - .gitignore
# ============================================

# --------------------------------------------
# Environment Files (Güvenlik)
# --------------------------------------------
infra/env/.env.dev
infra/env/.env.test
infra/env/.env.prod
.env
.env.*
!.env.*.example
!infra/env/.env.*.example
# Frontend: geliştirme ve örnek env dosyaları commit edilebilir
!apps/frontend/.env.development
!apps/frontend/.env.example

# --------------------------------------------
# .NET / Backend
# --------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.user
*.userosscache
*.suo
*.cache
*.vspscc
*.vssscc
.vs/
*.nupkg
packages/
*.DotSettings.user
project.lock.json
*.nuget.props
*.nuget.targets

# --------------------------------------------
# Node.js / Frontend
# --------------------------------------------
node_modules/
dist/
build/
.next/
out/
*.tsbuildinfo
.npm/
.yarn/
.pnp.*

# --------------------------------------------
# IDE / Editor
# --------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --------------------------------------------
# Docker
# --------------------------------------------
.docker/

# --------------------------------------------
# Testing
# --------------------------------------------
coverage/
*.lcov
TestResults/
.coverage

# --------------------------------------------
# Logs
# --------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --------------------------------------------
# OS Files
# --------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# --------------------------------------------
# Temporary Files
# --------------------------------------------
*.tmp
*.temp
*.bak
*.orig

# --------------------------------------------
# MinIO Local Data (Development)
# --------------------------------------------
minio-data/

# --------------------------------------------
# Database Local Files
# --------------------------------------------
*.mdf
*.ldf
*.bak
